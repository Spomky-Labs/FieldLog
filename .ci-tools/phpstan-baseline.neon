			count: 1
			path: ../src/Form/EntryFormHandler.php

		-
			message: '#^Cannot call method getPathname\(\) on Symfony\\Component\\HttpFoundation\\File\\File\|null\.$#'
			identifier: method.nonObject
			count: 1
