{% extends 'base.html.twig' %}

{% block title %}FieldLog{% endblock %}

{% block body %}
    <div class="min-h-screen bg-base-100 text-base-content p-4 flex flex-col gap-6">

        <!-- Header -->
        <header class="text-center">
            <h1 class="text-3xl font-bold text-primary">📒 FieldLog</h1>
            <p class="text-sm text-base-content/60">Take quick notes and attach files.</p>
        </header>

        <!-- New Entry Button -->
        <div class="flex justify-center">
            <a href="{{ path('entry_new') }}" class="btn btn-primary">
                ➕ New Entry
            </a>
        </div>

        <!-- Entries List -->
        {% if entries is empty %}
            <div class="text-center text-base-content/60">
                <p>No entries yet.</p>
            </div>
        {% else %}
            <div class="flex flex-col gap-4">
                {% for entry in entries %}
                    <div class="card bg-base-200 shadow">
                        <div class="card-body p-4">
                            <h2 class="card-title text-primary-content text-lg">
                                {{ entry.title }}
                            </h2>
                            <p class="text-sm text-base-content/80 line-clamp-3">
                                {{ entry.content|striptags|slice(0, 200) ~ '...' }}
                            </p>
                            <div class="card-actions justify-between mt-2 text-xs text-base-content/50">
                                <span>📅 {{ entry.createdAt|date('Y-m-d H:i') }}</span>
                                <a href="{{ path('entry_show', { id: entry.id }) }}" class="link link-primary">View</a>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endblock %}
