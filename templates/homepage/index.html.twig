{% extends 'base.html.twig' %}

{% block title %}FieldLog{% endblock %}

{% block body %}
    <!-- Hero -->
    <header id="header" class="hero min-h-[40vh]">
        <div class="hero-content text-center flex flex-col gap-3">
            <span id="icon" aria-hidden="true" class="text-7xl sm:text-8xl md:text-9xl leading-none">📒</span>
            <h1 id="brand" class="text-5xl sm:text-6xl md:text-7xl font-extrabold text-primary leading-tight">
                <a href="{{ path('list') }}">FieldLog</a>
            </h1>

            <p id="subtitle" class="text-base sm:text-lg md:text-xl text-base-content/70">
                Take quick notes and attach files.
            </p>
        </div>
    </header>

    <!-- Introduction -->
    <section class="mt-12 max-w-2xl mx-auto text-center px-4">
        <h2 class="text-2xl font-semibold mb-4">Why FieldLog?</h2>
        <p class="text-base text-base-content/70 leading-relaxed">
            FieldLog is your lightweight digital notebook.
            Quickly capture notes during meetings, inspections, or brainstorming sessions.
            Attach documents, images, or links to keep everything organized in one place.
            Whether you're in the office or on the move, FieldLog helps you stay focused and productive.
        </p>
    </section>

    <!-- Call To Action -->
    <div class="mt-10 flex justify-center">
        <a href="{{ path('list') }}"
           class="btn btn-primary btn-lg gap-2 shadow-lg">
            ✍️ Start logging
        </a>
    </div>
{% endblock %}
