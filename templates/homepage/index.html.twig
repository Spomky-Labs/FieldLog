{% extends 'base.html.twig' %}

{% block title %}FieldLog{% endblock %}

{% block body %}
    <!-- Entries List -->
    {% if entries is empty %}
        <div class="text-center text-base-content/60">
            <p>No entries yet.</p>
        </div>
    {% else %}
        <div class="flex flex-col gap-4">
            {% for entry in entries %}
                <div class="card bg-base-200 shadow">
                    <div class="card-body p-4">
                        <h2 class="card-title text-base-content text-lg font-semibold">
                            <a href="{{ path('entry_show', { id: entry.id }) }}">
                                {{ entry.title }}
                            </a>
                        </h2>
                        <p class="text-sm text-base-content/70 italic">
                            {% set icon = {
                                'text': '📝',
                                'file': '📎',
                                'link': '🔗'
                            }[entry.type.value] ?? '❓' %}
                            {{ icon }} {{ entry.type.value|capitalize }}
                        </p>
                        <div class="card-actions justify-between mt-2 text-xs text-base-content/50">
                            <span>📅 {{ entry.publishedAt|format_date('medium') }}</span>
                            <a href="{{ path('entry_show', { id: entry.id }) }}" class="link link-primary">View</a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
