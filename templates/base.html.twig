<!DOCTYPE html>
<html lang="{{ app.locale }}">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>{% block title %}Welcome!{% endblock %}</title>
    {% block stylesheets %}
    {% endblock %}

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body class="overflow-y-auto">
<div class="min-h-screen bg-base-100 text-base-content p-4 flex flex-col items-center">
    <div class="w-full max-w-2xl flex flex-col gap-6">
        <header class="text-center">
            <h1 class="text-3xl font-bold text-primary">📒 FieldLog</h1>
            <p class="text-sm text-base-content/60">Take quick notes and attach files.</p>
        </header>
        {% block body %}{% endblock %}
    </div>
</div>

<!-- Floating Action Button -->
<div class="fixed bottom-4 right-4 z-40 group">
    <!-- Main FAB -->
    <div tabindex="0" role="button" class="btn btn-circle btn-primary shadow-xl">
        <twig:ux:icon name="lucide:plus" class="size-5 text-white" />
    </div>

    <!-- Action buttons -->
    <ul class="absolute bottom-16 right-0 flex flex-col items-end space-y-2 opacity-0 scale-0 group-focus-within:opacity-100 group-focus-within:scale-100 transition-all duration-200">
        <!-- Text -->
        <li>
            <a href="{{ path('entry_new', { type: 'text' }) }}" class="btn btn-sm btn-circle btn-neutral tooltip tooltip-left" data-tip="New text note">
                <twig:ux:icon name="lucide:file-text" class="size-4" />
            </a>
        </li>
        <!-- URL -->
        <li>
            <a href="{{ path('entry_new', { type: 'link' }) }}" class="btn btn-sm btn-circle btn-neutral tooltip tooltip-left" data-tip="New link">
                <twig:ux:icon name="lucide:link" class="size-4" />
            </a>
        </li>
        <!-- File -->
        <li>
            <a href="{{ path('entry_new', { type: 'file' }) }}" class="btn btn-sm btn-circle btn-neutral tooltip tooltip-left" data-tip="Upload file">
                <twig:ux:icon name="lucide:file" class="size-4" />
            </a>
        </li>
        <!-- Photo capture -->
        <li>
            <a href="{{ path('entry_new', { type: 'file', capture: 'camera' }) }}" class="btn btn-sm btn-circle btn-neutral tooltip tooltip-left" data-tip="Take a photo">
                <twig:ux:icon name="lucide:camera" class="size-4" />
            </a>
        </li>
    </ul>
</div>
</body>
</html>
